{
    "compilerOptions": {
      "jsx": "react-jsx",
      "types": ["react"],       
      "target": "esnext",
      "module": "esnext",
      "moduleResolution": "bundler",
      "strict": true,
      "allowJs": true,
      "skipLibCheck": true,
      "isolatedModules": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src"]
  }
  